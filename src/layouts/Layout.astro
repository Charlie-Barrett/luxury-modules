---
import '../styles/chrome.css';
import SpeedInsights from '@vercel/speed-insights/astro';
interface Props {
  title: string;
  description?: string;
  schema?: object | null;
  /* Social card. `image` is a site-root path (/images/foo.jpg) — resolved to an
     absolute URL below because Facebook, LinkedIn, WhatsApp and X all reject
     relative og:image values. `share` is the sentence shown under the card;
     it falls back to the meta description when a page has nothing bespoke.
     `imageAlt` describes the picture itself for screen readers on X. */
  image?: string;
  imageAlt?: string;
  share?: string;
  /* 404 and any future thank-you/utility page: keep it out of the index. */
  noindex?: boolean;
}
const {
  title,
  description = '',
  schema = null,
  image = '/images/index-1.jpg',
  imageAlt = 'A Luxury Modules earth-sheltered building, grass roof settled into the landscape',
  share = '',
  noindex = false,
} = Astro.props;
const ogImage = new URL(image, Astro.site).href;
const ogDescription = share || description;
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:title" content={title} />
{ogDescription && <meta property="og:description" content={ogDescription} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Luxury Modules" />
<meta property="og:locale" content="en_GB" />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{ogDescription && <meta name="twitter:description" content={ogDescription} />}
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />
<script is:inline id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="d376d24e-91fd-4bff-a1c4-00867f89529e" data-blockingmode="auto" type="text/javascript"></script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
<!-- Google tag (gtag.js) — blocked until Cookiebot statistics consent, same as Clarity -->
<script is:inline type="text/plain" data-cookieconsent="statistics" async src="https://www.googletagmanager.com/gtag/js?id=G-XVZG3PT397"></script>
<script is:inline type="text/plain" data-cookieconsent="statistics">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-XVZG3PT397');
</script>
<script is:inline type="text/plain" data-cookieconsent="statistics">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "y155ou003q");
</script>
<SpeedInsights />
</head>
<body>
<header class="site">
  <div class="navwrap">
    <a href="/" style="display:flex;align-items:center;gap:14px;text-decoration:none" aria-label="Luxury Modules home"><img src="/images/luxury-modules-logo-150px.png" alt="Luxury Modules" style="height:46px;width:auto" onerror="this.style.display='none'" /><div class="logo"><span class="lm">LUXURY MODULES</span><span class="tag">Official UK Partner of Revonia</span></div></a>
    <nav class="main">
      <a href="/products/">Our Modules</a>
      <a href="/hobbit-houses/">Hobbit Houses</a>
      <div class="navsub">
        <button class="navsub-btn" type="button" aria-expanded="false" aria-haspopup="true">Spaces <span class="caret">&#9662;</span></button>
        <div class="navsub-menu">
          <a href="/spaces/garden-room/">Garden Rooms</a>
          <a href="/spaces/garden-office/">Garden Offices</a>
          <a href="/spaces/garden-gym/">Garden Gyms</a>
          <a href="/spaces/garden-annexe/">Garden Annexes</a>
          <a href="/spaces/glamping-pods/">Glamping Pods</a>
        </div>
      </div>
      <a href="/pricing/">Pricing</a>
      <a href="/how-it-works/">How It Works</a>
      <a href="/commercial/">Commercial</a>
      <a href="/book-a-call/">Contact</a>
      <a href="/start-your-project/" class="cta">Start Your Project</a>
    </nav>
    <button class="burger" aria-label="Open menu">&#9776;</button>
  </div>
</header>
<slot />
<footer class="site">
  <div class="foot-grid">
    <div><div class="logo"><span class="lm">LUXURY MODULES</span><span class="tag">Official UK Partner of Revonia</span></div>
      <p style="margin-top:16px;font-size:13.5px;max-width:300px">Turnkey vaulted living spaces, cellars and saunas. 1,500+ projects across Europe. 25-year structural warranty. Planning handled.</p></div>
    <nav aria-labelledby="foot-explore"><b id="foot-explore" style="color:#fff">Explore</b>
      <ul class="footlinks">
        <li><a href="/products/">Our Modules</a></li>
        <li><a href="/hobbit-houses/">Hobbit Houses</a></li>
        <li><a href="/pricing/">Pricing</a></li>
        <li><a href="/turnkey/">What's Included</a></li>
        <li><a href="/design-yours/">Design Your Module</a></li>
        <li><a href="/commercial/">For Commercial</a></li>
      </ul></nav>
    <nav aria-labelledby="foot-learn"><b id="foot-learn" style="color:#fff">Learn</b>
      <ul class="footlinks">
        <li><a href="/how-it-works/">How It Works</a></li>
        <li><a href="/planning-permission/">Planning Permission</a></li>
        <li><a href="/revonia/">The Revonia Partnership</a></li>
        <li><a href="/faq/">FAQs</a></li>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/cookies/">Cookie Policy</a></li>
        <li><a href="/terms/">Terms &amp; Conditions</a></li>
      </ul></nav>
    <div><b style="color:#fff">Contact</b>
      <ul class="footlinks">
        <li class="plain">Stuart Doust</li>
        <li><a href="mailto:sales@luxurymodules.co.uk">sales@luxurymodules.co.uk</a></li>
        <li><a href="tel:+447814550508">+44 7814 550 508</a></li>
        <li><a href="/start-your-project/">Start Your Project</a></li>
      </ul></div>
  </div>
  <div class="legal">&copy; 2026 Luxury Modules Ltd. All prices are indicative "from" prices excluding VAT, updated January 2026.<br />
    <!-- Company number verified against Companies House, 20 Aug 2026. The address below is the
         one Companies House lists for the company; Stu to confirm it is the registered office
         and to supply the VAT number, then delete the "pending" span and add: VAT No. XXXXXXXXX. -->
    Luxury Modules Limited, registered in England and Wales, company number 16007852. Registered office: 111-113 High Street, Evesham, Worcestershire, WR11 4XP. <span class="pending">(VAT number to be added.)</span><br />
    <span class="builtby">Built by <a href="https://charliebarrett.co.uk" rel="noopener">CBC Ltd</a></span>
  </div>
</footer>
<div id="brochure-modal" role="dialog" aria-modal="true" aria-labelledby="bm-title">
  <div class="bm-card">
    <button class="bm-close" aria-label="Close" type="button">&#10005;</button>
    <div id="brochure-body">
      <h3 id="bm-title" class="serif">The 2026 brochure &amp; price list</h3>
      <p>The full price list, what's included module by module, and the process from first call to handover.</p>
      <form id="brochure-form">
        <label>First name<input type="text" name="firstname" required autocomplete="given-name" /></label>
        <label>Email<input type="email" name="email" required autocomplete="email" /></label>
        <div class="hp-field" aria-hidden="true"><label>Company website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button type="submit">Send me the brochure</button>
        <p id="bm-err" class="bm-err"></p>
        <p class="bm-consent">We'll use your details to send the brochure and occasional project stories. No spam, unsubscribe anytime.</p>
      </form>
    </div>
  </div>
</div>
<script is:inline>
  if (location.search.indexOf('notes=1') > -1) document.body.classList.add('show-draft-notes');
  var b=document.querySelector('.burger');
  if(b){b.addEventListener('click',function(){var n=document.querySelector('nav.main');n.classList.toggle('open');b.textContent=n.classList.contains('open')?'\u2715':'\u2630';});}
  var sb=document.querySelector('.navsub-btn');
  if(sb){var sp=sb.parentNode;
    sb.addEventListener('click',function(e){e.stopPropagation();sp.classList.toggle('open');sb.setAttribute('aria-expanded',sp.classList.contains('open'));});
    document.addEventListener('click',function(e){if(sp.classList.contains('open')&&!sp.contains(e.target)){sp.classList.remove('open');sb.setAttribute('aria-expanded','false');}});
    sp.addEventListener('keydown',function(e){if(e.key==='Escape'){sp.classList.remove('open');sb.setAttribute('aria-expanded','false');sb.focus();}});}
  var bmodal=document.getElementById('brochure-modal');
  document.addEventListener('click',function(e){
    var a=e.target.closest('a[href="#brochure"], .js-brochure');
    if(a){e.preventDefault();var row=a.closest('.emailcap,.emailrow');var em=row&&row.querySelector('input[type=email]')?row.querySelector('input[type=email]').value:'';
      if(em)bmodal.querySelector('input[name=email]').value=em;
      bmodal.classList.add('open');bmodal.querySelector('input[name=firstname]').focus();return;}
    if(e.target.closest('.bm-close')||e.target===bmodal){bmodal.classList.remove('open');}
  });
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&bmodal.classList.contains('open'))bmodal.classList.remove('open');});
  var bform=document.getElementById('brochure-form');
  var bformOpened=Date.now();
  if(bform){bform.addEventListener('submit',function(e){
    e.preventDefault();
    /* Spam guards (20 Aug 2026): honeypot must stay empty, and a real person
       takes longer than 3s. Fail silently so bots learn nothing. */
    if(bform.website && bform.website.value){return;}
    if(Date.now()-bformOpened < 3000){return;}
    var fn=bform.firstname.value.trim(),em=bform.email.value.trim(),btn=bform.querySelector('button[type=submit]');
    btn.disabled=true;btn.textContent='Sending…';
    fetch('https://api-eu1.hsforms.com/submissions/v3/integration/submit/145893440/10337a2d-9ba9-49e8-8cb2-10535dc96348',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({fields:[{objectTypeId:'0-1',name:'firstname',value:fn},{objectTypeId:'0-1',name:'email',value:em}],context:{pageUri:location.href,pageName:document.title}})
    }).then(function(r){
      if(r.ok){document.getElementById('brochure-body').innerHTML='<h3 class="serif" style="font-size:26px;color:var(--navy)">Thank you, '+fn.replace(/[<>&]/g,'')+'.</h3><p>We\'ll email you the 2026 brochure and price list within one working day.</p>';}
      else{return r.json().then(function(j){throw new Error((j.errors&&j.errors[0]&&j.errors[0].message)||('HTTP '+r.status));});}
    }).catch(function(err){
      btn.disabled=false;btn.textContent='Try again';
      document.getElementById('bm-err').textContent='Something went wrong — please try again, or email sales@luxurymodules.co.uk.';
      console.error('Brochure form:',err);
    });
  });}
</script>
</body>
</html>
