---
import Layout from '../layouts/Layout.astro';
/* Generic 404. Vercel serves dist/404.html automatically for any unmatched path,
   so this one template covers every broken URL — including the WordPress ones
   that slip past the redirect map in vercel.json.
   noindex: a 404 returns the right status code, but the belt-and-braces tag
   stops the page itself being indexed if anything ever serves it as a 200. */
const schema = null;
---
<Layout
  title="Page Not Found | Luxury Modules"
  description="That page has moved or no longer exists. Browse our modules, spaces and pricing, or get in touch."
  share="Lost? Our modules, ranges and pricing are all a click away."
  image="/images/og/404.jpg"
  imageAlt="A stone-fronted module set into a wooded lakeside bank at dusk, arched glazing lit warm, a timber jetty in the foreground"
  schema={schema}
  noindex={true}
>
  <section class="nf">
    <div class="nf-inner">
      <p class="nf-code">404</p>
      <h1 class="serif">Oops&hellip; this page has gone on an adventure</h1>
      <p class="nf-lead">
        It looks like the page you&rsquo;re after has disappeared down a rabbit hole &mdash; or perhaps it&rsquo;s off
        enjoying a little hobbit-sized holiday.
      </p>
      <p class="nf-lead">Don&rsquo;t worry, there are plenty more of where that came from.</p>
      <div class="nf-actions">
        <a class="nf-btn" href="/products/">Browse our modules</a>
        <a class="nf-btn ghost" href="/book-a-call/">Talk to us</a>
      </div>
      <div class="nf-links">
        <p class="nf-links-title">Popular pages</p>
        <ul>
          <li><a href="/products/cave-saunas/">Underground saunas</a></li>
          <li><a href="/spaces/garden-room/">Garden rooms</a></li>
          <li><a href="/hobbit-houses/">Hobbit houses</a></li>
          <li><a href="/products/vaulted-cellars/">Vaulted cellars</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/how-it-works/">How it works</a></li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    background: var(--cream);
    padding: clamp(56px, 9vw, 110px) 24px clamp(64px, 10vw, 120px);
  }
  .nf-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .nf-code {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(64px, 13vw, 116px);
    line-height: 1;
    color: var(--gold);
    margin: 0 0 8px;
  }
  .nf h1 {
    font-size: clamp(28px, 4.4vw, 44px);
    color: var(--navy);
    margin: 0 0 20px;
  }
  .nf-lead {
    font-size: 17.5px;
    color: var(--ink);
    max-width: 560px;
    margin: 0 auto 14px;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin: 32px 0 0;
  }
  .nf-btn {
    display: inline-block;
    background: var(--navy);
    color: #fff;
    text-decoration: none;
    padding: 13px 26px;
    border-radius: 2px;
    font-size: 15px;
    letter-spacing: 0.03em;
  }
  .nf-btn:hover { background: var(--navy2); }
  .nf-btn.ghost {
    background: transparent;
    color: var(--navy);
    border: 1px solid var(--navy);
  }
  .nf-btn.ghost:hover { background: var(--navy); color: #fff; }
  .nf-links { margin-top: 44px; }
  .nf-links-title {
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .nf-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    justify-content: center;
  }
  .nf-links a {
    color: var(--navy);
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 2px;
  }
  .nf-links a:hover { color: var(--gold-dark); }
</style>
