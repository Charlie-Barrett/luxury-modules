---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/qualify.css';
import body from '../partials/qualify.html?raw';
const schema = null;
---
<Layout title="Start Your Project | Luxury Modules | 2-Minute Project Checker" description="Three quick questions on your land, planning and budget, then an honest answer on whether an underground garden room, cellar or sauna is possible for you."  image="/images/og/start-your-project.jpg" imageAlt="A Modular 60 with a shingled arched facade and grass roof, opening onto a timber deck among pine trees" share="Three questions on your land, planning and budget, then a straight answer on whether this is possible for you." schema={schema}>
  <div class="pg-qualify"><Fragment set:html={body} /></div>
</Layout>
