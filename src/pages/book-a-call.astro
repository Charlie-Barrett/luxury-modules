---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/contact.css';
import body from '../partials/contact.html?raw';
const schema = null;
---
<Layout title="Contact | Luxury Modules | Book a Scoping Call" description="Book a free 20-minute scoping call with Luxury Modules. Your land, planning position and budget — honest answers on what's possible and what it costs."  image="/images/og/book-a-call.jpg" imageAlt="A stone-clad module lit from within at dusk, a couple sitting and talking by a firepit on the deck" share="Twenty minutes with Stuart on your land, your planning position and your budget. Honest answers, no pitch." schema={schema}>
  <div class="pg-contact"><Fragment set:html={body} /></div>
</Layout>
