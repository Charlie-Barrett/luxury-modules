---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/design-yours.css';
import body from '../partials/design-yours.html?raw';
const schema = null;
---
<Layout title="Design Your Module | Luxury Modules" description="Configure your Luxury Modules space: choose a range, size, finishes and options, then get an indicative turnkey price for your underground garden building."  image="/images/og/design-yours.jpg" imageAlt="A module with a brick and stone arched facade set into a planted bank, glazed arched doors open onto a terrace" share="Pick a range, size, roof and wall finish, and see an indicative turnkey price before you speak to anyone." schema={schema}>
  <div class="pg-design-yours"><Fragment set:html={body} /></div>
</Layout>
